# Copy this file to .env.local and fill in the values for your environment.
# Every variable the browser needs must start with NEXT_PUBLIC_.

# Base URL of the Verify Engine backend API.
# Leave EMPTY while the backend is still being built: the API client then
# returns the mock data each call site supplies, so forms and dashboards keep
# working locally. Set it to switch every call to real requests.
NEXT_PUBLIC_API_BASE_URL=

# Public origin of this site. Used for absolute URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | staging | production
NEXT_PUBLIC_APP_ENV=development
